# DataQuest frontend environment variables
#
# Copy this file to client/.env for local development.
# client/.env is git-ignored - never commit real values.

# Local backend:
REACT_APP_SERVER_URL=http://localhost:5000

# Production: set this in the Vercel project settings instead of committing it.
# REACT_APP_SERVER_URL=https://your-dataquest-api.onrender.com