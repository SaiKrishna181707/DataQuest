# DataQuest API environment variables
#
# Copy this file to server/.env and fill in your own values.
# server/.env is git-ignored - never commit real credentials.

# MongoDB Atlas connection string for YOUR DataQuest cluster.
MONGODB_URI=

# Database name inside that cluster.
MONGODB_DB=dataquest

# Strong random secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of frontend origins allowed to send credentialed requests.
# Local development:
CORS_ORIGIN=http://localhost:3000
# Production example (replace with your own Vercel URL):
# CORS_ORIGIN=https://your-dataquest-app.vercel.app

# Local port. Render provides PORT automatically in production.
PORT=5000

# NODE_ENV is set to production by Render. Leave it unset locally.